PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bakas_factory

# Signs the sign-in tokens. 32 or more random characters; the server refuses to start in production with less.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out.
JWT_SECRET=change-me-to-a-long-random-string

# Email for PIN reset links. With no SMTP_HOST the link is printed in the server console.
PUBLIC_URL=http://192.168.1.10:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bakas Factory <no-reply@example.com>

# Set to production on the real server. Then a weak JWT_SECRET stops the start-up, and browsers are refused unless listed below.
# NODE_ENV=production

# The laptop web app's address(es), comma separated. The phone app needs nothing here.
# Empty: any browser origin is allowed in development, none in production.
# CORS_ORIGINS=http://192.168.1.10:5173

# How many proxies (nginx, a load balancer) sit in front of this server. Leave 0 when phones connect directly:
# anything else lets a caller forge the address the sign-in lockout counts against.
# TRUST_PROXY=0

# Only if you need them:
# HOST=0.0.0.0
# DB_POOL_MAX=15
